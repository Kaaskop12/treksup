# Public values (safe in the browser). Set the same two in Vercel -> Project Settings -> Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=https://uqavwdxnlgguchbuqnsl.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable key from Supabase dashboard -> Project Settings -> API>

# Canonical site URL for sitemap/robots/metadata (default https://treksup.com).
NEXT_PUBLIC_SITE_URL=https://treksup.com

# Live Stripe Payment Link for the TMB 2027 booking plan (https://buy.stripe.com/...).
# Unset => the "Get the plan" button shows an email capture instead (fake-door price test).
NEXT_PUBLIC_PAYLINK_TMB_2027_PLAN=
# Set to 1 ONLY on Preview to allow Stripe test links (buy.stripe.com/test_...).
NEXT_PUBLIC_ALLOW_TEST_PAYLINKS=
